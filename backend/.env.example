# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION BACKEND — Hôtel Président Borne Satisfaction
# Copiez ce fichier en .env et remplissez chaque variable.
# Ne jamais committer le fichier .env dans git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données MySQL ─────────────────────────────────────────────────────
# Utilisez un compte MySQL dédié avec droits limités (voir docs/MYSQL_SETUP.md)
DB_HOST=localhost
DB_USER=hotel_app
DB_PASSWORD=VOTRE_MOT_DE_PASSE_MYSQL_ICI
DB_NAME=hotel_satisfaction

# ── Serveur Express ───────────────────────────────────────────────────────────
PORT=5001

# ── CORS : origines autorisées ────────────────────────────────────────────────
# Liste séparée par virgules, SANS espaces après les virgules.
# En développement local : http://localhost:5173
# En production WiFi hôtel : ajoutez l'IP du serveur, ex: http://192.168.1.100:5173
# IMPORTANT : toujours inclure le protocole (http:// ou https://)
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.x.x:5173

# ── Environnement ─────────────────────────────────────────────────────────────
# Valeurs acceptées : development | production
# En production : active les cookies secure (HTTPS) + logs JSON
NODE_ENV=development

# ── JWT Secret ────────────────────────────────────────────────────────────────
# OBLIGATOIRE — Secret de signature des tokens admin.
# Minimum 32 caractères. Le serveur refuse de démarrer sans une valeur forte.
# Le serveur bloque aussi les valeurs par défaut connues.
#
# Pour générer un secret sécurisé (128 caractères hex) :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
JWT_SECRET=REMPLACEZ_PAR_UNE_VALEUR_GENEREE_AVEC_CRYPTO

# ── Comptes admin initiaux (utilisés par "npm run migrate") ──────────────────
# Ces valeurs servent uniquement à créer les comptes en base lors du premier lancement.
# Après la création, ces variables peuvent être vidées ou supprimées du .env.
#
# INTERDIT : admin123, password, admin, superadmin, 123456
# Utilisez des mots de passe forts (min 12 caractères, majuscules, chiffres, symboles)
#
ADMIN_LOGIN=admin
ADMIN_PASSWORD=VOTRE_MOT_DE_PASSE_ADMIN_FORT
# Alternative : utilisez ADMIN_PASSWORD_HASH (bcrypt, 12 rounds) pour ne pas stocker en clair
# Générer avec : node backend/scripts/hash-password.js
ADMIN_PASSWORD_HASH=

SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=VOTRE_MOT_DE_PASSE_SUPERADMIN_FORT
SUPERADMIN_PASSWORD_HASH=

# ── Niveau de log (optionnel) ─────────────────────────────────────────────────
# Valeurs : trace | debug | info | warn | error | fatal
# Par défaut : info
LOG_LEVEL=info

# ── Brevo (email + SMS clients — page "Clients" du dashboard admin) ──────────
# 1. Créez un compte gratuit sur https://www.brevo.com
# 2. Menu → SMTP & API → API Keys → "Générer une nouvelle clé API" (v3)
BREVO_API_KEY=

# Email expéditeur — doit être vérifié dans Brevo (Menu → Expéditeurs & IP → Expéditeurs)
BREVO_SENDER_EMAIL=contact@votrehotel.ci
BREVO_SENDER_NAME=Hôtel Président Yamoussoukro

# Nom d'expéditeur SMS — 11 caractères alphanumériques MAX, sans espaces ni accents
# (ex: HotelPres). Certains pays exigent une validation préalable du sender ID auprès de Brevo.
BREVO_SMS_SENDER=HotelPres
