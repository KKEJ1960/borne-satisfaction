# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION FRONTEND — Hôtel Président Borne Satisfaction
# Copiez ce fichier en .env et adaptez VITE_API_URL à votre environnement.
# Ne jamais committer le fichier .env dans git.
# ─────────────────────────────────────────────────────────────────────────────

# ── URL du backend Express ────────────────────────────────────────────────────
# Si cette variable est absente, l'app cible automatiquement
# http://<adresse-du-serveur>:5001 (détection automatique par window.location.hostname).
#
# Développement local :
# VITE_API_URL=http://localhost:5001
#
# Production (Nginx reverse proxy HTTPS) :
# VITE_API_URL=https://borne.hotel-president.ci/api
#
# Réseau WiFi hôtel (IP fixe, sans DNS) :
# VITE_API_URL=http://192.168.1.100:5001
#
VITE_API_URL=http://localhost:5001
